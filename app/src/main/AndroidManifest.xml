        <activity android:name=".WhackActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".TapSpeedActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ReactionActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".PuzzleActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".DiceActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ColorMatchActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".SnakeActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".SimonActivity" android:exported="false" android:screenOrientation="portrait" />

