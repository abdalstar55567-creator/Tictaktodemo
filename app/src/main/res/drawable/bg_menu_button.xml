<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="270" android:startColor="#FFFFFF" android:centerColor="#DDF8FF" android:endColor="#78CFFF" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:left="5dp" android:top="3dp" android:right="5dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
