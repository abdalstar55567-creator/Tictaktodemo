<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="100+"
            android:textColor="@color/gold"
            android:textSize="54sp"
            android:letterSpacing="0.04"
            android:shadowColor="#8B5CFF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="14"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp"
            android:text="ألعاب صغيرة... متعة كبيرة!"
            android:textColor="@color/text_dim"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="اختر لعبتك 🎮"
            android:textColor="@color/text_main"
            android:textSize="21sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/playXo"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/bg_button"
            android:text="❌⭕   إكس أو"
            android:textColor="@color/text_main"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/playMemory"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_dim"
            android:text="🧠   تحدي الذاكرة"
            android:textColor="@color/text_main"
            android:textSize="19sp" />

        <Button
            android:id="@+id/playRps"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_dim"
            android:text="✊   حجر ورقة مقص"
            android:textColor="@color/text_main"
            android:textSize="19sp" />

        <Button
            android:id="@+id/playGuess"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_dim"
            android:text="🔢   خمن الرقم"
            android:textColor="@color/text_main"
            android:textSize="19sp" />

        <Button
            android:id="@+id/menuSound"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_dim"
            android:textColor="@color/text_dim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp"
            android:text="100+ • العب، تحدَّ نفسك، وكرر!"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
