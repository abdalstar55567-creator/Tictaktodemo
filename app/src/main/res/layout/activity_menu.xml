<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_sky"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_menu_header"
            android:elevation="8dp"
            android:paddingStart="14dp"
            android:paddingTop="20dp"
            android:paddingEnd="14dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮  ✨  🧩"
                android:textSize="27sp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="178dp"
                android:layout_marginTop="7dp"
                android:contentDescription="100+"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@drawable/logo_100plus_glossy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="عالم من المرح والتحدي"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:shadowColor="#55305B86"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/menuCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#EFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_menu_button"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:text="اختر لعبتك وابدأ المغامرة!"
                android:textColor="#1264A5"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gamesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/menuAbout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_menu_button"
            android:elevation="3dp"
            android:text="ℹ️  عن التطبيق والخصوصية"
            android:textColor="#155B91"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/menuMusic"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_menu_button"
            android:elevation="3dp"
            android:textColor="#155B91"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/menuSound"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_menu_button"
            android:elevation="3dp"
            android:textColor="#155B91"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
