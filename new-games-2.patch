@@ -0,0 +1,121 @@
+package com.example.tictactoe
+
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.widget.Button
+import android.widget.TextView
+
+/** أوقف الوقت عند 5.00 ثوانٍ بالضبط. الأرقام تختفي بعد ثانيتين! */
+class StopTimeActivity : BaseGameActivity() {
+
+    private val targetMs = 5000L
+    private val hideAfterMs = 2000L
+    private val handler = Handler(Looper.getMainLooper())
+
+    private var running = false
+    private var startTime = 0L
+
+    private lateinit var timerText: TextView
+    private lateinit var statusText: TextView
+    private lateinit var bestText: TextView
+    private lateinit var actionButton: Button
+
+    private val ticker = object : Runnable {
+        override fun run() {
+            if (!running) return
+            val elapsed = SystemClock.elapsedRealtime() - startTime
+            timerText.text = if (elapsed < hideAfterMs) format(elapsed) else "؟.؟؟"
+            handler.postDelayed(this, 30)
+        }
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        initScreen("⏱️ أوقف الوقت")
+
+        content.addView(
+            label("اضغط «ابدأ» ثم «أوقف» عندما تظن أنه مرّت 5 ثوانٍ بالضبط. العدّاد يختفي بعد ثانيتين!", 16f, R.color.text_dim, false),
+            lp(top = dp(8))
+        )
+
+        bestText = label("", 15f, R.color.gold)
+        content.addView(bestText, lp(top = dp(14)))
+
+        timerText = label("0.00", 72f, R.color.x_color)
+        content.addView(timerText, lp(top = dp(24)))
+
+        statusText = label("الهدف: 5.00 ثانية", 19f)
+        content.addView(statusText, lp(top = dp(8), bottom = dp(22)))
+
+        actionButton = button("ابدأ") { onAction() }
+        actionButton.textSize = 22f
+        content.addView(actionButton, lp(height = dp(72), top = dp(8)))
+
+        content.addView(button("تصفير أفضل نتيجة", false) {
+            Scores.put(this, "stop_best", 0)
+            updateBest()
+        }, lp(height = dp(46), top = dp(28)))
+        updateBest()
+    }
+
+    private fun format(ms: Long): String {
+        val hundredths = ms / 10
+        return "${hundredths / 100}.${(hundredths % 100).toString().padStart(2, '0')}"
+    }
+
+    private fun updateBest() {
+        val best = Scores.get(this, "stop_best")
+        bestText.text = if (best == 0) "" else "أفضل دقة: فرق ${best} ملّي ثانية"
+    }
+
+    private fun onAction() {
+        if (!running) {
+            running = true
+            startTime = SystemClock.elapsedRealtime()
+            statusText.text = "الهدف: 5.00 ثانية"
+            actionButton.text = "أوقف"
+            Feedback.tap(this)
+            handler.post(ticker)
+        } else {
+            val elapsed = SystemClock.elapsedRealtime() - startTime
+            stopRunning()
+            timerText.text = format(elapsed)
+            val diff = Math.abs(elapsed - targetMs).toInt()
+            val verdict = when {
+                diff <= 50 -> "🤩 مذهل! دقة خارقة"
+                diff <= 200 -> "😎 ممتاز!"
+                diff <= 500 -> "🙂 جيد"
+                else -> "😅 حاول مرة أخرى"
+            }
+            statusText.text = "$verdict\nالفرق: $diff ملّي ثانية"
+            // نخزّن 1 على الأقل حتى لا يُفهم الصفر على أنه «لا توجد نتيجة»
+            if (Scores.saveLow(this, "stop_best", maxOf(diff, 1))) {
+                statusText.text = statusText.text.toString() + "\n🏆 رقم قياسي جديد!"
+            }
+            if (diff <= 200) Feedback.win(this) else Feedback.lose(this)
+            updateBest()
+        }
+    }
+
+    private fun stopRunning() {
+        running = false
+        handler.removeCallbacks(ticker)
+        actionButton.text = "ابدأ"
+    }
+
+    override fun onPause() {
+        if (running) {
+            stopRunning()
+            timerText.text = "0.00"
+            statusText.text = "توقفت اللعبة. اضغط «ابدأ» للمحاولة من جديد"
+        }
+        super.onPause()
+    }
+
+    override fun onDestroy() {
+        handler.removeCallbacks(ticker)
+        super.onDestroy()
+    }
+}
