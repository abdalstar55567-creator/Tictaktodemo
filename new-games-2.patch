+package com.example.tictactoe
+
+import android.os.Bundle
+import android.view.View
+import android.widget.Button
+import android.widget.LinearLayout
+import android.widget.TextView
+
+/** شد الحبل: لاعبان على نفس الهاتف. اضغط بأسرع ما تستطيع لسحب العلامة إلى جهتك. */
+class TugOfWarActivity : BaseGameActivity() {
+
+    private val steps = 9          // عدد خلايا الحبل
+    private val start = steps / 2  // موضع البداية في المنتصف
+    private var pos = start
+    private var over = false
+    private var topWins = 0
+    private var bottomWins = 0
+
+    private val cells = ArrayList<View>()
+    private lateinit var topButton: Button
+    private lateinit var bottomButton: Button
+    private lateinit var statusText: TextView
+    private lateinit var scoreText: TextView
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        initScreen("🪢 شد الحبل (لاعبان)")
+
+        content.addView(
+            label("لكل لاعب زر. اضغط بسرعة لتسحب العلامة إلى جهتك وأول من يوصلها إلى طرفه يفوز!", 16f, R.color.text_dim, false),
+            lp(top = dp(8))
+        )
+
+        scoreText = label("", 17f, R.color.gold)
+        content.addView(scoreText, lp(top = dp(10)))
+
+        // زر اللاعب العلوي مقلوب ليقرأه من يجلس في الجهة المقابلة
+        topButton = button("اسحب! 🔴") { pull(top = true) }
+        topButton.textSize = 22f
+        topButton.rotation = 180f
+        content.addView(topButton, lp(height = dp(84), top = dp(12)))
+
+        val rope = LinearLayout(this)
+        rope.orientation = LinearLayout.VERTICAL
+        for (i in 0 until steps) {
+            val cell = View(this)
+            cells.add(cell)
+            rope.addView(cell, lp(height = dp(20), top = dp(if (i == 0) 0 else 4)))
+        }
+        content.addView(rope, lp(top = dp(12)))
+
+        bottomButton = button("اسحب! 🔵") { pull(top = false) }
+        bottomButton.textSize = 22f
+        content.addView(bottomButton, lp(height = dp(84), top = dp(12)))
+
+        statusText = label("", 18f)
+        content.addView(statusText, lp(top = dp(12)))
+
+        content.addView(button("جولة جديدة", false) { newRound() }, lp(height = dp(46), top = dp(14)))
+        newRound()
+    }
+
+    private fun newRound() {
+        pos = start
+        over = false
+        topButton.isEnabled = true
+        bottomButton.isEnabled = true
+        statusText.text = "ابدأوا!"
+        render()
+    }
+
+    private fun pull(top: Boolean) {
+        if (over) return
+        pos += if (top) -1 else 1
+        Feedback.tap(this)
+
+        if (pos <= 0) {
+            finishRound("🔴 فاز اللاعب العلوي!")
+            topWins++
+        } else if (pos >= steps - 1) {
+            finishRound("🔵 فاز اللاعب السفلي!")
+            bottomWins++
+        }
+        render()
+    }
+
+    private fun finishRound(message: String) {
+        over = true
+        topButton.isEnabled = false
+        bottomButton.isEnabled = false
+        statusText.text = message
+        Feedback.win(this)
+    }
+
+    private fun render() {
+        for (i in 0 until steps) {
+            val colorRes = when {
+                i == pos -> R.color.gold
+                i < start -> R.color.o_color
+                i > start -> R.color.x_color
+                else -> R.color.cell
+            }
+            val alpha = if (i == pos) 255 else 90
+            val bg = Ui.panelBg(this, color(colorRes), 8)
+            bg.alpha = alpha
+            cells[i].background = bg
+        }
+        scoreText.text = "🔴 $topWins   -   $bottomWins 🔵"
+    }
+}
