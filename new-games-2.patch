@@ -0,0 +1,109 @@
+package com.example.tictactoe
+
+import android.os.Bundle
+import android.view.View
+import android.widget.LinearLayout
+import android.widget.TextView
+import kotlin.random.Random
+
+/** أطفئ كل الأضواء: الضغط على مربع يقلب حالته وحالة جيرانه الأربعة. */
+class LightsOutActivity : BaseGameActivity() {
+
+    private val size = 5
+    private val on = Array(size) { BooleanArray(size) }
+    private val cells = Array(size) { arrayOfNulls<View>(size) }
+    private var moves = 0
+    private var won = false
+
+    private lateinit var movesText: TextView
+    private lateinit var bestText: TextView
+    private lateinit var statusText: TextView
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        initScreen("💡 أطفئ الأضواء")
+
+        content.addView(
+            label("اضغط على مربع لقلب حالته وحالة جيرانه. أطفئ كل الأضواء بأقل عدد من النقلات!", 16f, R.color.text_dim, false),
+            lp(top = dp(8))
+        )
+
+        movesText = label("", 20f, R.color.x_color)
+        content.addView(movesText, lp(top = dp(12)))
+
+        bestText = label("", 15f, R.color.gold)
+        content.addView(bestText, lp(top = dp(2)))
+
+        statusText = label("", 18f)
+        content.addView(statusText, lp(top = dp(8), bottom = dp(10)))
+
+        val grid = LinearLayout(this)
+        grid.orientation = LinearLayout.VERTICAL
+        for (r in 0 until size) {
+            val line = row()
+            for (c in 0 until size) {
+                val cell = View(this)
+                cell.setOnClickListener { press(r, c, true) }
+                cells[r][c] = cell
+                line.addView(cell, weightLp(dp(58)))
+            }
+            grid.addView(line, lp(top = dp(if (r == 0) 0 else 6)))
+        }
+        content.addView(grid, lp(top = dp(6)))
+
+        content.addView(button("لعبة جديدة", false) { newGame() }, lp(height = dp(46), top = dp(22)))
+        newGame()
+    }
+
+    private fun newGame() {
+        for (r in 0 until size) for (c in 0 until size) on[r][c] = false
+        // نخلط باستخدام ضغطات حقيقية ليكون الحل ممكناً دائماً
+        do {
+            for (i in 0 until 12) press(Random.nextInt(size), Random.nextInt(size), false)
+        } while (isSolved())
+        moves = 0
+        won = false
+        statusText.text = "أطفئ كل الأضواء 💡"
+        render()
+    }
+
+    private fun toggle(r: Int, c: Int) {
+        if (r in 0 until size && c in 0 until size) on[r][c] = !on[r][c]
+    }
+
+    private fun press(r: Int, c: Int, player: Boolean) {
+        if (player && won) return
+        toggle(r, c)
+        toggle(r - 1, c)
+        toggle(r + 1, c)
+        toggle(r, c - 1)
+        toggle(r, c + 1)
+        if (!player) return
+
+        moves++
+        Feedback.tap(this)
+        if (isSolved()) {
+            won = true
+            statusText.text = "🎉 أحسنت! أطفأتها في $moves نقلة"
+            Feedback.win(this)
+            if (Scores.saveLow(this, "lights_best", moves)) {
+                statusText.text = "🏆 رقم قياسي جديد: $moves نقلة"
+            }
+        }
+        render()
+    }
+
+    private fun isSolved(): Boolean = on.all { row -> row.none { it } }
+
+    private fun render() {
+        for (r in 0 until size) {
+            for (c in 0 until size) {
+                val colorInt = color(if (on[r][c]) R.color.gold else R.color.cell)
+                cells[r][c]?.background = Ui.panelBg(this, colorInt, 10)
+            }
+        }
+        movesText.text = "النقلات: $moves"
+        val best = Scores.get(this, "lights_best")
+        bestText.text = if (best == 0) "" else "أفضل نتيجة: $best نقلة"
+    }
+}
diff --git a/app/src/main/java/com/example/tictactoe/SequenceActivity.kt b/app/src/main/java/com/example/tictactoe/SequenceActivity.kt
new file mode 100644
index 0000000..58803d4
--- /dev/null
+++ b/app/src/main/java/com/example/tictactoe/SequenceActivity.kt
@@ -0,0 +1,172 @@
+package com.example.tictactoe
+
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.widget.Button
+import android.widget.TextView
+import kotlin.random.Random
+
+/** أكمل التسلسل: اختر الرقم التالي في السلسلة. عشرة أسئلة في كل جولة. */
+class SequenceActivity : BaseGameActivity() {
+
+    private val handler = Handler(Looper.getMainLooper())
+    private val totalQuestions = 10
+    private var question = 0
+    private var score = 0
+    private var answer = 0
+    private var locked = false
+    private var finished = false
+
+    private lateinit var progressText: TextView
+    private lateinit var bestText: TextView
+    private lateinit var seqText: TextView
+    private lateinit var statusText: TextView
+    private val optionButtons = ArrayList<Button>()
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        initScreen("🔗 أكمل التسلسل")
+
+        content.addView(
+            label("اكتشف القاعدة واختر الرقم التالي في السلسلة.", 16f, R.color.text_dim, false),
+            lp(top = dp(8))
+        )
+
+        progressText = label("", 20f, R.color.x_color)
+        content.addView(progressText, lp(top = dp(14)))
+
+        bestText = label("", 15f, R.color.gold)
+        content.addView(bestText, lp(top = dp(2)))
+
+        seqText = label("", 30f)
+        content.addView(seqText, lp(top = dp(22)))
+
+        statusText = label("", 18f)
+        content.addView(statusText, lp(top = dp(10), bottom = dp(14)))
+
+        for (rowIndex in 0 until 2) {
+            val r = row()
+            for (k in 0 until 2) {
+                val idx = rowIndex * 2 + k
+                val b = button("", false) { choose(idx) }
+                b.textSize = 22f
+                optionButtons.add(b)
+                r.addView(b, weightLp(dp(64)))
+            }
+            content.addView(r, lp(top = dp(8)))
+        }
+
+        content.addView(button("ابدأ من جديد", false) { newGame() }, lp(height = dp(46), top = dp(24)))
+        newGame()
+    }
+
+    private fun newGame() {
+        question = 0
+        score = 0
+        finished = false
+        nextQuestion()
+    }
+
+    private fun updateTexts() {
+        progressText.text = "السؤال ${minOf(question, totalQuestions)} من $totalQuestions   |   النقاط: $score"
+        val best = Scores.get(this, "seq_best")
+        bestText.text = if (best == 0) "" else "أفضل نتيجة: $best من $totalQuestions"
+    }
+
+    /** يبني تسلسلاً من خمسة أرقام: أول أربعة تُعرض، والخامس هو الجواب. */
+    private fun buildSequence(): List<Int> {
+        return when (Random.nextInt(4)) {
+            0 -> { // حسابي: نضيف نفس العدد كل مرة
+                val start = Random.nextInt(1, 20)
+                val step = Random.nextInt(2, 10) * if (Random.nextBoolean()) 1 else -1
+                List(5) { start + step * it }
+            }
+            1 -> { // هندسي: نضرب بنفس العدد كل مرة
+                val start = Random.nextInt(1, 4)
+                val ratio = Random.nextInt(2, 4)
+                var v = start
+                List(5) { val cur = v; v *= ratio; cur }
+            }
+            2 -> { // مربعات الأعداد
+                val n = Random.nextInt(1, 7)
+                List(5) { (n + it) * (n + it) }
+            }
+            else -> { // فروق متزايدة
+                val start = Random.nextInt(1, 10)
+                val d = Random.nextInt(1, 4)
+                var v = start
+                var step = d
+                List(5) { val cur = v; v += step; step += 1; cur }
+            }
+        }
+    }
+
+    private fun nextQuestion() {
+        if (question >= totalQuestions) {
+            endGame()
+            return
+        }
+        question++
+        locked = false
+
+        val seq = buildSequence()
+        answer = seq[4]
+        seqText.text = seq.take(4).joinToString("  ،  ") + "  ،  ؟"
+        statusText.text = ""
+
+        val options = linkedSetOf(answer)
+        var guard = 0
+        while (options.size < 4 && guard < 200) {
+            guard++
+            val offset = Random.nextInt(1, 11) * if (Random.nextBoolean()) 1 else -1
+            options.add(answer + offset)
+        }
+        val shuffled = options.toMutableList()
+        shuffled.shuffle()
+        optionButtons.forEachIndexed { i, b ->
+            b.text = shuffled[i].toString()
+            b.isEnabled = true
+            b.alpha = 1f
+        }
+        updateTexts()
+    }
+
+    private fun choose(i: Int) {
+        if (locked || finished) return
+        locked = true
+        val picked = optionButtons[i].text.toString().toIntOrNull()
+        if (picked == answer) {
+            score++
+            statusText.text = "✅ صحيح!"
+            Feedback.match(this)
+        } else {
+            statusText.text = "❌ الجواب الصحيح: $answer"
+            Feedback.lose(this)
+        }
+        optionButtons.forEach { it.isEnabled = false }
+        updateTexts()
+        handler.postDelayed({
+            if (!isFinishing && !isDestroyed) nextQuestion()
+        }, 900)
+    }
+
+    private fun endGame() {
+        finished = true
+        locked = true
+        optionButtons.forEach { it.isEnabled = false }
+        seqText.text = "🏁 النتيجة: $score من $totalQuestions"
+        statusText.text = if (Scores.saveHigh(this, "seq_best", score)) {
+            "🏆 رقم قياسي جديد!"
+        } else {
+            "اضغط «ابدأ من جديد» للمحاولة مرة أخرى"
+        }
+        if (score >= 7) Feedback.win(this) else Feedback.draw(this)
+        updateTexts()
+    }
+
+    override fun onDestroy() {
+        handler.removeCallbacksAndMessages(null)
+        super.onDestroy()
+    }
+}
