@@ -0,0 +1,115 @@
+package com.example.tictactoe
+
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.widget.Button
+import android.widget.TextView
+import kotlin.random.Random
+
+class CoinFlipActivity : BaseGameActivity() {
+
+    private val handler = Handler(Looper.getMainLooper())
+    private var busy = false
+    private var streak = 0
+    private var rounds = 0
+    private var hits = 0
+
+    private lateinit var coinText: TextView
+    private lateinit var statusText: TextView
+    private lateinit var streakText: TextView
+    private lateinit var bestText: TextView
+    private lateinit var headsButton: Button
+    private lateinit var tailsButton: Button
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        initScreen("🪙 وجه أم كتابة؟")
+
+        content.addView(
+            label("خمّن على أي وجه ستستقر العملة. كم سلسلة فوز تستطيع تحقيقها؟", 16f, R.color.text_dim, false),
+            lp(top = dp(8))
+        )
+
+        streakText = label("", 20f, R.color.x_color)
+        content.addView(streakText, lp(top = dp(14)))
+
+        bestText = label("", 15f, R.color.gold)
+        content.addView(bestText, lp(top = dp(2)))
+
+        coinText = label("🪙", 90f)
+        content.addView(coinText, lp(top = dp(18)))
+
+        statusText = label("اختر وجه أو كتابة", 20f)
+        content.addView(statusText, lp(top = dp(6), bottom = dp(18)))
+
+        val r = row()
+        headsButton = button("👑 وجه") { guess(true) }
+        tailsButton = button("📜 كتابة") { guess(false) }
+        headsButton.textSize = 20f
+        tailsButton.textSize = 20f
+        r.addView(headsButton, weightLp(dp(64)))
+        r.addView(tailsButton, weightLp(dp(64)))
+        content.addView(r, lp(top = dp(8)))
+
+        content.addView(button("ابدأ من جديد", false) { resetAll() }, lp(height = dp(46), top = dp(24)))
+        updateTexts()
+    }
+
+    private fun setChoicesEnabled(on: Boolean) {
+        headsButton.isEnabled = on
+        tailsButton.isEnabled = on
+    }
+
+    private fun updateTexts() {
+        streakText.text = "سلسلة الفوز: $streak   |   الإصابات: $hits من $rounds"
+        val best = Scores.get(this, "coin_best")
+        bestText.text = if (best == 0) "" else "أفضل سلسلة: $best"
+    }
+
+    private fun resetAll() {
+        handler.removeCallbacksAndMessages(null)
+        busy = false
+        streak = 0
+        rounds = 0
+        hits = 0
+        coinText.text = "🪙"
+        statusText.text = "اختر وجه أو كتابة"
+        setChoicesEnabled(true)
+        updateTexts()
+    }
+
+    private fun guess(heads: Boolean) {
+        if (busy) return
+        busy = true
+        setChoicesEnabled(false)
+        coinText.text = "🌀"
+        statusText.text = "العملة تدور..."
+        Feedback.tap(this)
+
+        handler.postDelayed({
+            val resultHeads = Random.nextBoolean()
+            coinText.text = if (resultHeads) "👑" else "📜"
+            rounds++
+            if (resultHeads == heads) {
+                streak++
+                hits++
+                statusText.text = "🎉 صحيح! خرجت ${if (resultHeads) "وجه" else "كتابة"}"
+                Feedback.win(this)
+                Scores.saveHigh(this, "coin_best", streak)
+            } else {
+                streak = 0
+                statusText.text = "😅 خرجت ${if (resultHeads) "وجه" else "كتابة"}، حاول مجدداً"
+                Feedback.lose(this)
+            }
+            updateTexts()
+            setChoicesEnabled(true)
+            busy = false
+        }, 700)
+    }
+
+    override fun onDestroy() {
+        handler.removeCallbacksAndMessages(null)
+        super.onDestroy()
+    }
+}
